{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://einstein.local/schemas/run-result-v1.json",
  "title": "Externally supervised execution manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "proposal_id", "proposal_path", "proposal_sha256",
    "admission_path", "admission_sha256", "pinned_code_revision",
    "launch_head_revision", "command", "started_at", "finished_at",
    "elapsed_seconds", "limits", "artifact_bytes", "stdout_path",
    "stdout_sha256", "stderr_path", "stderr_sha256",
    "process_return_code", "execution_status", "research_verdict",
    "supervisor_error", "interpretation"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "proposal_id": {"type": "string", "pattern": "^RP-[0-9]{4}-[0-9]{2}-[0-9]{2}-[A-Z0-9-]+$"},
    "proposal_path": {"type": "string", "minLength": 1},
    "proposal_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "admission_path": {"type": "string", "minLength": 1},
    "admission_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pinned_code_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "launch_head_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "started_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "finished_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "elapsed_seconds": {"type": "number", "minimum": 0},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_time_seconds", "memory_bytes", "max_new_artifact_bytes"],
      "properties": {
        "wall_time_seconds": {"type": "integer", "minimum": 1},
        "memory_bytes": {"type": "integer", "minimum": 1},
        "max_new_artifact_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "artifact_bytes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "final_before_manifest", "final_growth", "peak_observed_growth", "poll_seconds"],
      "properties": {
        "baseline": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "final_before_manifest": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "final_growth": {"type": "integer", "minimum": 0},
        "peak_observed_growth": {"type": "integer", "minimum": 0},
        "poll_seconds": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "stdout_path": {"type": "string", "minLength": 1},
    "stdout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stderr_path": {"type": "string", "minLength": 1},
    "stderr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "process_return_code": {"type": ["integer", "null"]},
    "execution_status": {"enum": ["completed", "process_error", "resource_stop_wall", "resource_stop_artifact", "supervisor_error", "interrupted"]},
    "research_verdict": {"type": "null"},
    "supervisor_error": {"type": ["string", "null"]},
    "interpretation": {"type": "string", "minLength": 30}
  }
}
