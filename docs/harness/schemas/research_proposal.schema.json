{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://einstein.local/schemas/research-proposal-v2.json",
  "title": "Einstein tiling research commitment",
  "type": "object",
  "required": [
    "schema_version", "id", "title", "kind", "status", "program_id",
    "scope_level", "thesis", "mission_connection", "alternatives_considered",
    "failure_or_pivot", "prior_art", "outcomes", "stop_rule"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "id": {"type": "string", "pattern": "^RP-[0-9]{4}-[0-9]{2}-[0-9]{2}-[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 8},
    "kind": {"enum": ["research-program", "experiment", "promotion"]},
    "status": {"enum": ["draft", "ready", "closed"]},
    "program_id": {"type": "string"},
    "scope_level": {
      "enum": ["field-level-problem", "architecture-independent-class", "recognized-mathematical-family", "specific-construction", "single-instance"]
    },
    "thesis": {"type": "string", "minLength": 30},
    "mission_connection": {"type": "string", "minLength": 30},
    "alternatives_considered": {"type": "string", "minLength": 30},
    "failure_or_pivot": {"type": "string", "minLength": 30},
    "prior_art": {"$ref": "#/$defs/priorArt"},
    "outcomes": {
      "type": "array", "minItems": 2,
      "items": {"$ref": "#/$defs/outcome"}
    },
    "stop_rule": {"$ref": "#/$defs/stopRule"},
    "experiment": {"$ref": "#/$defs/experiment"},
    "promotion": {"$ref": "#/$defs/promotion"}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "experiment"}}, "required": ["kind"]},
      "then": {"required": ["experiment"]}
    },
    {
      "if": {"properties": {"kind": {"const": "promotion"}}, "required": ["kind"]},
      "then": {"required": ["promotion"]}
    }
  ],
  "$defs": {
    "filePin": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "priorArt": {
      "type": "object",
      "required": ["snapshot_date", "primary_sources", "non_redundancy", "user_facts_resolved"],
      "properties": {
        "snapshot_date": {"type": "string", "format": "date"},
        "primary_sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "non_redundancy": {"type": "string", "minLength": 30},
        "user_facts_resolved": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["statement", "source_ids", "consequence"],
            "properties": {
              "statement": {"type": "string", "minLength": 30},
              "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "consequence": {"type": "string", "minLength": 30}
            }
          }
        }
      }
    },
    "outcome": {
      "type": "object", "required": ["result", "action"],
      "properties": {
        "result": {"type": "string", "minLength": 30},
        "action": {"type": "string", "minLength": 30}
      }
    },
    "stopRule": {
      "type": "object", "required": ["condition", "no_automatic_escalation"],
      "properties": {
        "condition": {"type": "string", "minLength": 30},
        "no_automatic_escalation": {"const": true}
      }
    },
    "budget": {
      "type": "object",
      "required": ["wall_time_seconds", "memory_bytes", "max_new_artifact_bytes", "artifact_roots", "external_supervision"],
      "properties": {
        "wall_time_seconds": {"type": "integer", "minimum": 1},
        "memory_bytes": {"type": "integer", "minimum": 1},
        "max_new_artifact_bytes": {"type": "integer", "minimum": 0},
        "artifact_roots": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "external_supervision": {"const": true}
      }
    },
    "executablePin": {
      "type": "object",
      "required": ["path", "sha256", "version_command", "version_output_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "version_command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "version_output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "reproducibility": {
      "type": "object",
      "required": ["code_revision", "require_clean_tree", "code_paths", "inputs", "environment_files", "executables"],
      "properties": {
        "code_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "require_clean_tree": {"const": true},
        "code_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/filePin"}},
        "no_external_inputs_reason": {"type": "string", "minLength": 30},
        "environment_files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/filePin"}},
        "executables": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/executablePin"}}
      }
    },
    "experimentEvidence": {
      "type": "object",
      "required": ["certificate_or_verifier", "promotion_boundary"],
      "properties": {
        "certificate_or_verifier": {"type": "string", "minLength": 30},
        "promotion_boundary": {"type": "string", "minLength": 30},
        "verifier": {"oneOf": [{"$ref": "#/$defs/filePin"}, {"type": "null"}]},
        "no_verifier_reason": {"type": "string", "minLength": 30}
      }
    },
    "runRecord": {
      "type": "object",
      "required": ["manifest_path", "stdout_path", "stderr_path"],
      "properties": {
        "manifest_path": {"type": "string", "minLength": 1},
        "stdout_path": {"type": "string", "minLength": 1},
        "stderr_path": {"type": "string", "minLength": 1}
      }
    },
    "experiment": {
      "type": "object",
      "required": ["proposition", "command", "budget", "reproducibility", "evidence", "run_record"],
      "properties": {
        "proposition": {"type": "string", "minLength": 30},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "budget": {"$ref": "#/$defs/budget"},
        "reproducibility": {"$ref": "#/$defs/reproducibility"},
        "evidence": {"$ref": "#/$defs/experimentEvidence"},
        "run_record": {"$ref": "#/$defs/runRecord"}
      }
    },
    "candidateDossier": {
      "type": "object",
      "required": ["geometry", "allowed_isometries", "identity_status", "identity_evidence", "periodicity_status", "periodicity_evidence", "whole_plane_tilability", "tilability_evidence", "contact_language", "contact_evidence", "all_tilings_aperiodicity", "aperiodicity_evidence", "total_decoder"],
      "properties": {
        "geometry": {"$ref": "#/$defs/filePin"},
        "allowed_isometries": {"enum": ["full-E2", "orientation-preserving"]},
        "identity_status": {"enum": ["known", "unclassified", "novel-after-audit"]},
        "identity_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/filePin"}},
        "periodicity_status": {"enum": ["periodic", "no-periodic-certificate", "aperiodic-proved"]},
        "periodicity_evidence": {"$ref": "#/$defs/filePin"},
        "whole_plane_tilability": {"enum": ["proved", "not-proved"]},
        "tilability_evidence": {"$ref": "#/$defs/filePin"},
        "contact_language": {"enum": ["complete", "partial", "absent"]},
        "contact_evidence": {"$ref": "#/$defs/filePin"},
        "all_tilings_aperiodicity": {"enum": ["proved", "not-proved"]},
        "aperiodicity_evidence": {"$ref": "#/$defs/filePin"},
        "total_decoder": {"enum": ["proved", "not-proved", "not-applicable"]},
        "decoder_evidence": {"$ref": "#/$defs/filePin"}
      }
    },
    "promotion": {
      "type": "object",
      "required": ["claim_kind", "claim_id", "requested_label", "source_document", "evidence", "literature_sources"],
      "properties": {
        "claim_kind": {"enum": ["candidate", "theorem", "method", "novelty"]},
        "claim_id": {"type": "string", "minLength": 4},
        "requested_label": {"type": "string", "minLength": 4},
        "source_document": {"$ref": "#/$defs/filePin"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/filePin"}},
        "literature_sources": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "candidate_dossier": {"$ref": "#/$defs/candidateDossier"}
      },
      "allOf": [
        {
          "if": {"properties": {"claim_kind": {"const": "candidate"}}, "required": ["claim_kind"]},
          "then": {"required": ["candidate_dossier"]}
        }
      ]
    }
  }
}
